          ],
          "outputs": {
            "roleAssignmentId": {
              "type": "string",
              "value": "[subscriptionResourceId('Microsoft.Authorization/roleAssignments', guid(subscription().id, parameters('principalId'), parameters('managedIdentityName'), 'acdd72a7-3385-48ef-bd42-f606fba81ae7'))]"
            }
          }
        }
      },
      "dependsOn": [
